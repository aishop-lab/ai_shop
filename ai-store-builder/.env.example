# AI Store Builder - Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API (for AI features)
GEMINI_API_KEY=

GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_CREDENTIALS=  # JSON string

RAZORPAY_KEY_ID=        # Get from Razorpay Dashboard
RAZORPAY_KEY_SECRET=    # Get from Razorpay Dashboard
RAZORPAY_WEBHOOK_SECRET=       # Set in Razorpay Webhooks
NEXT_PUBLIC_RAZORPAY_KEY_ID=   # Same as RAZORPAY_KEY_ID (client-side)

# ================================
# SHIPROCKET (NEED TO ADD)
# ================================
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# ================================
# RESEND EMAIL (NEED TO ADD)
# ================================
RESEND_API_KEY=      # Get from Resend Dashboard
RESEND_FROM_EMAIL=   # Verified domain email

# ================================
# SITE CONFIG
# ================================
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=

REMOVE_BG_API_KEY=

CREDENTIALS_ENCRYPTION_KEY=

NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

NEXT_PUBLIC_GOOGLE_CLIENT_ID=

SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

ETSY_CLIENT_ID=

# Cron Job Secret
CRON_SECRET=

# Supabase CLI Access Token
SUPABASE_ACCESS_TOKEN=

# ================================
# GOOGLE ADS
# ================================
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

# ================================
# META ADS
# ================================
META_APP_ID=
META_APP_SECRET=
